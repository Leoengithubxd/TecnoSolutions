@{
    ViewBag.Title = "Facturas";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}
@model List<TechnoSolutions.Dtos.InvoiceDto>

<h2>Listado de Facturas</h2>

@if (Model == null || !Model.Any())
{
    <p>No hay facturas registradas.</p>
}
else
{
    <div class="table-container">
        <table class="table table-primary">
            <thead>
                <tr>
                    <th>Factura #</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in Model)
                {
                    <tr id="invoice-@invoice.IdInvoice">
                        <td>@invoice.IdInvoice</td>
                        <td>@invoice.RegisteredAt.ToString("dd/MM/yyyy")</td>
                        <td>@($"{invoice.TotalPriceProduct:N0} COP")</td>
                        <td>
                            <a href="@Url.Action("InvoiceDetails", "Product", new { invoiceId = invoice.IdInvoice })" class="btn btn-info">
                                Ver Detalles
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a href="@Url.Action("SelectProducts", "Product")" class="btn btn-secondary">Volver</a>

<script>
    function printInvoice() {
        window.print();
    }
</script>

<style>
    body {
        background-color: #f4f4f9;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Estilos para la tabla, similar a AddProducts */
    .table-primary {
        --bs-table-bg: #0d3039;
        --bs-table-color: whitesmoke;
    }

    .table-container {
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        background-color: #091324;
        margin-bottom: 20px;
    }

    /* Estilos para los botones */
    .btn-info {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        background-color: #17a2b8;
        color: whitesmoke;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s;
    }

        .btn-info:hover {
            background-color: #138496;
        }

    .btn-secondary {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        background-color: #6c757d;
        color: whitesmoke;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s;
        margin-top: 20px;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">