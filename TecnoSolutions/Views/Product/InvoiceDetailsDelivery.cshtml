        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s;
        border: none;
    }

    .btn-primary {
        background-color: #0d3039;
        color: whitesmoke;
    }

        .btn-primary:hover {
            background-color: #091021;
        }

    .btn-success {
        background-color: #198754;
    }

        .btn-success:hover {
            background-color: #157347;
        }

    .btn-secondary {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        background-color: midnightblue;
