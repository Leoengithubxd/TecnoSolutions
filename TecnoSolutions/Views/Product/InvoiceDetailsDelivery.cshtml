@{
    ViewBag.Title = "Detalle de Factura";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<h2>Detalle de Factura (Para entrega)</h2>

<div class="invoice-container">
    <div class="invoice-header">
        <table class="table">
            <tr>
                <th class="table-primary">Fecha Inicio:</th>
                @{
                    string date = "Sin asignación";
                    if (Model != null && Model.RegisteredAt != null && Model.RegisteredAt != DateTime.MinValue)
                    {
                        date = Model.RegisteredAt.ToString("yyyy-MM-dd HH:mm");
                    }
                }
                <td>@date</td>
            </tr>
        </table>
        <p><strong>Cliente:</strong> @Model.FirstName (@Model.Email)</p>
        <p><strong>Dirección:</strong> @Model.ProductsAddress, @Model.ProductsCity, @Model.ProductsDepartment</p>
    </div>

    <div class="invoice-details">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio Unitario</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model.Products)
                {
                    <tr>
                        <td>@producto.NameProduct</td>
                        <td>@producto.Quantity</td>
                        <td>@($"{producto.UnitPrice:N0} COP")</td>
                        <td>@($"{producto.TotalPriceProduct:N0} COP")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="invoice-total">
        <h3 class="text-success">Total: <strong>@($"{Model.TotalPriceProduct:N0} COP")</strong></h3>
    </div>

    <div class="invoice-actions">
        <button onclick="printInvoice()" class="btn btn-success">
            <i class="bi bi-printer"></i> Imprimir PDF
        </button>
    </div>
</div>
<a href="@Url.Action("DeliveryHome", "Product")" class="btn btn-secondary">Volver</a>

<script>
    function printInvoice() {
        window.print();
    }
</script>

