@{
    ViewBag.Title = "Detalle de Factura";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<h2>Detalle de Factura</h2>

<div class="invoice-container">
    <div class="invoice-header">
        <table class="table">
            <tr>
                <th class="table-primary">Fecha Inicio:</th>
                @{
                    string date = (Model.RegisteredAt == null || Model.RegisteredAt == DateTime.MinValue)
                        ? "Sin asignación"
                        : Model.RegisteredAt.ToString("yyyy-MM-dd HH:mm");
                }
                <td>@date</td>
            </tr>
        </table>
        <p><strong>Cliente:</strong> @Model.FirstName (@Model.Email)</p>
        <p><strong>Dirección:</strong> @Model.ProductsAddress, @Model.ProductsCity, @Model.ProductsDepartment</p>
    </div>

    <div class="invoice-details">
        <table class="table table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio Unitario</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model.Products)
                {
                    <tr>
                        <td>@producto.NameProduct</td>
                        <td>@producto.Quantity</td>
                        <td>@($"{producto.UnitPrice:N0} COP")</td>
                        <td>@($"{producto.TotalPriceProduct:N0} COP")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="invoice-total">
        <h3 class="text-success">Total: <strong>@($"{Model.TotalPriceProduct:N0} COP")</strong></h3>
    </div>

    <div class="invoice-actions">
        <button onclick="printInvoice()" class="btn btn-success">
            <i class="bi bi-printer"></i> Imprimir PDF
        </button>
        <a href="@Url.Action("Invoice", "Product")" class="btn btn-secondary">Volver</a>
    </div>
</div>

<script>
    function printInvoice() {
        window.print();
    }
</script>

<style>
    body {
        background-color: #f4f4f9;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .invoice-container {
        padding: 20px;
        margin: 20px;
        background-color: #091324;
        border-radius: 15px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        color: whitesmoke;
    }

    .invoice-header table {
        margin-bottom: 15px;
    }

    .invoice-header p {
        margin: 5px 0;
    }

    .invoice-details table {
        width: 100%;
        margin-bottom: 20px;
    }

    /* Estilos para los botones */
    .btn-success {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        background-color: #17a2b8;
        color: whitesmoke;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s;
    }

        .btn-success:hover {
            background-color: #138496;
        }

    .btn-secondary {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        background-color: #6c757d;
        color: whitesmoke;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s;
        margin-top: 10px;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    .invoice-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">