@{
    ViewBag.Title = "QuoteDetails";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<h2>Detalles de la Cotización</h2>

<table class="table table-container">
    <tr>
        <th class="table-primary">ID Cotización:</th>
        <td>@Model.IdQuote</td>
    </tr>
    <tr>
        <th class="table-primary">Nombre:</th>
        <td>@Model.PersonName</td>
    </tr>
    <tr>
        <th class="table-primary">Estado:</th>
        <td>@Model.StateName</td>
    </tr>
    <tr>
        <th class="table-primary">Dirección de Servicio:</th>
        <td>@Model.ServiceAddress</td>
    </tr>
    <tr>
        <th class="table-primary">Departamento:</th>
        <td>@Model.ServiceDepartment</td>
    </tr>
    <tr>
        <th class="table-primary">Ciudad:</th>
        <td>@Model.ServiceCity</td>
    </tr>
    <tr>
        <th class="table-primary">Fecha Inicio:</th>
        @{
            string start = (Model.StarDate == null || Model.StarDate == DateTime.MinValue)
                ? "Sin asignación"
                : Model.StarDate?.ToString("yyyy-MM-dd HH:mm");
        }
        <td>@start</td>
    </tr>
    <tr>
        <th class="table-primary">Fecha Fin:</th>
        @{
            string End = (Model.EndDate == null || Model.EndDate == DateTime.MinValue)
                ? "Sin asignación"
                : Model.StarDate?.ToString("yyyy-MM-dd HH:mm");
            <td>@End</td>
        }
    </tr>
    <tr>
        <th class="table-primary">Cuadrilla:</th>
        <td>@Model.IdCrewPerson</td>
    </tr>
    <tr>
        <th class="table-primary">Precio:</th>
        <td>@($"{Model.Price:N0} COP")</td>
    </tr>
</table>
@if (Model.IdState == 2)
{
    <button class="btn btn-success" onclick="BuyQuote(@Model.IdQuote)">Comprar Cotización</button>
    <button class="btn btn-danger" onclick="DeleteQuote(@Model.IdQuote)">Descartar Cotización</button>
    <a href="@Url.Action("ApproveQuote", "Quote")" class="btn btn-secondary">Volver</a>
}
else
{
    <a href="@Url.Action("ApproveQuote", "Quote")" class="btn btn-secondary">Volver</a>
    <button onclick="printQuote()" class="btn btn-info">Imprimir Cotización</button>
}

<script>
    function BuyQuote(idQuote) {
        if (confirm("¿Estás seguro de que deseas comprar esta cotización?")) {
            fetch('@Url.Action("BuyQuote", "Quote")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ idQuote: idQuote })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert("Cotización comprada con éxito.");
                    window.location.href = '@Url.Action("ApproveQuote", "Quote")';
                } else {
                    alert("Hubo un error al comprar la cotización.");
                }
            });
        }
    }

    function DeleteQuote(idQuote) {
        if (confirm("¿Estás seguro de que deseas descartar esta cotización?")) {
            fetch('@Url.Action("DeleteQuote", "Quote")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ idQuote: idQuote })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert("Cotización descartada con éxito.");
                    window.location.href = '@Url.Action("ApproveQuote", "Quote")';
                } else {
                    alert("Hubo un error al descartar la cotización.");
                }
            });
        }
    }
</script> @*Comprar cotizacion*@

<script>
    function printQuote() {
        window.print();
    }
</script> @*Imprimir*@

