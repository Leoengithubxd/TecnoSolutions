@{
    ViewBag.Title = "QuoteDetails";
    Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";
}

<h2>Detalles de la Cotización de tu Cuadrilla</h2>

<table class="table table-container">
    <tr>
        <th class="table-primary">ID Cotización:</th>
        <td>@Model.IdQuote</td>
    </tr>
    <tr>
        <th class="table-primary">Nombre:</th>
        <td>@Model.PersonName</td>
    </tr>
    <tr>
        <th class="table-primary">Estado:</th>
        <td>@Model.StateName</td>
    </tr>
    <tr>
        <th class="table-primary">Dirección de Servicio:</th>
        <td>@Model.ServiceAddress</td>
    </tr>
    <tr>
        <th class="table-primary">Departamento:</th>
        <td>@Model.ServiceDepartment</td>
    </tr>
    <tr>
        <th class="table-primary">Ciudad:</th>
        <td>@Model.ServiceCity</td>
    </tr>
    <tr>
        <th class="table-primary">Fecha Inicio:</th>
        @{
            string start = (Model.StarDate == null || Model.StarDate == DateTime.MinValue)
                ? "Sin asignación"
                : Model.StarDate?.ToString("yyyy-MM-dd HH:mm");
        }
        <td>@start</td>
    </tr>
    <tr>
        <th class="table-primary">Fecha Fin:</th>
        @{
            string End = (Model.EndDate == null || Model.EndDate == DateTime.MinValue)
                ? "Sin asignación"
                : Model.StarDate?.ToString("yyyy-MM-dd HH:mm");
            <td>@End</td>
        }
    </tr>
    <tr>
        <th class="table-primary">Cuadrilla:</th>
        <td>@Model.IdCrewPerson</td>
    </tr>
    <tr>
        <th class="table-primary">Precio:</th>
        <td>@($"{Model.Price:N0} COP")</td>
    </tr>
</table>
<a href="@Url.Action("EmployeeHome", "Quote")" class="btn btn-secondary">Volver</a>
<button onclick="printQuote()" class="btn btn-info">Imprimir Cotización</button>

<script>
    function printQuote() {
        window.print();
    }
</script> @*Imprimir*@

<style>
    body {
        background-color: #f4f4f9;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .table-primary {
        --bs-table-bg: #0d3039;
        --bs-table-color: whitesmoke;
    }

    .table-container {
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        background-color: #091324;
    }

    .header-title {
        font-size: 28px;
        color: #0d6efd;
        text-align: center;
        margin-bottom: 20px;
        background-color: #0d3039;
        padding: 10px;
        border-radius: 10px;
    }

    .btn-primary, .btn-success, .btn-danger {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s;
        border: none;
    }

    .btn-primary {
        background-color: #0d3039;
        color: whitesmoke;
    }

        .btn-primary:hover {
            background-color: #091021;
        }

    .btn-success {
        background-color: #198754;
    }

        .btn-success:hover {
            background-color: #157347;
        }

    .btn-secondary {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        background-color: midnightblue;
        color: whitesmoke;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    .btn-danger {
        background-color: #dc3545;
    }

        .btn-danger:hover {
            background-color: #bb2d3b;
        }

    .text-principal {
        color: whitesmoke;
    }

    .alert-danger {
        border-radius: 8px;
    }

    .btn-info {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        background-color: #17a2b8;
        color: whitesmoke;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s;
    }

        .btn-info:hover {
            background-color: #138496;
        }
</style>